{
  "name": "sqa-coverage-demo",
  "version": "1.0.0",
  "description": "SQA Coverage Demo",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:e2e": "playwright test"
  },
  

  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "jest": "29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }




}
